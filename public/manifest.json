{
  "name": "PDF下载助手 - PDF Downloader",
  "short_name": "PDF下载助手",
  "version": "1.2.0",
  "description": "自动捕获网页中的PDF文档，支持搜索、阅读和一键下载课程课件、论文、报告和内部资料。",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "pdf-icon.png",
      "32": "pdf-icon.png",
      "48": "pdf-icon.png",
      "128": "pdf-icon.png"
    },
    "default_title": "PDF下载助手"
  },
  "icons": {
    "16": "pdf-icon.png",
    "32": "pdf-icon.png",
    "48": "pdf-icon.png",
    "128": "pdf-icon.png"
  }
}
